<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MokkapiMock</AssemblyName>
    <RootNamespace>MokkapiMock</RootNamespace>
    <!-- Self-contained single-file publishes are deterministic across locales -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Handlebars.Net" Version="2.1.6" />
    <PackageReference Include="Bogus" Version="35.6.1" />
  </ItemGroup>

  <!-- Ship a bundled HTTPS certificate (when one was selected at export) next to the app.
       `Update` (not Include) sets copy metadata on the SDK's default-globbed items, so it
       never duplicates them and matches nothing harmlessly when no cert was bundled. -->
  <ItemGroup>
    <None Update="certs/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
